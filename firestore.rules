rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member() {
      return request.auth != null
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }
    function admin() {
      return member() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }
    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }
    function memberData(data) {
      return data.keys().hasAll(['name', 'login', 'role', 'active'])
        && data.keys().hasOnly(['name', 'login', 'role', 'active'])
        && shortText(data.name) && shortText(data.login)
        && data.role in ['student', 'admin'] && data.active is bool;
    }
    match /members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if admin() && memberData(request.resource.data);
      allow update: if admin() && uid != request.auth.uid && memberData(request.resource.data)
        && request.resource.data.login == resource.data.login
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }
    match /content/{page} {
      allow read: if page in ['about', 'projects', 'apply', 'contact', 'publications'];
      allow list: if true;
      allow write: if admin() && page in ['about', 'projects', 'apply', 'contact', 'publications']
        && request.resource.data.keys().hasAll(['en', 'fa'])
        && request.resource.data.keys().hasOnly(['en', 'fa'])
        && request.resource.data.en is string && request.resource.data.fa is string
        && request.resource.data.en.size() > 0 && request.resource.data.en.size() <= 12000
        && request.resource.data.fa.size() > 0 && request.resource.data.fa.size() <= 12000;
    }
    // Legacy equipment is read-only after the Cloudflare cutover.
    // Admin reads remain available for the one-time reviewed migration.
    match /equipment/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /equipmentLogs/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raiz-exams-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "routes": [{ "pattern": "exams-api.raizlab.ir", "custom_domain": true }],
  "vars": {
    "FIREBASE_PROJECT_ID": "raiz-lab-system",
    "ALLOWED_ORIGINS": "https://www.raizlab.ir,https://raizlab.ir"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "raiz-exams",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
